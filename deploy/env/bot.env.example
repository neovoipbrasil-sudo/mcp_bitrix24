# Bitrix24 -> Webhook de entrada (escopos: im, imbot, tasks, crm, user, disk)
B24_DEFAULT_WEBHOOK=
# Bot registrado no Bitrix24
BOT_ID=
BOT_TOKEN=
BOT_EVENT_HANDLER_URL=https://bot.neovoip.com.br/bitrix-events
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
