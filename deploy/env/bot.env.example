#   https://bot.neovoip.com.br/msntalk-events/<MSNTALK_WEBHOOK_SECRET>
MSNTALK_WEBHOOK_SECRET=
MSNTALK_TICKET_URL_TEMPLATE=https://app.msntalk.neovoip.com.br/atendimento?ticketId={ticketId}
